<?xml version="1.0" encoding="utf-8"?>
<!-- 图标背景层：深色底（表盘外圈），对角线柔和渐变。
     之前的 shape 径向渐变缺 gradientRadius，在 Launcher 上渲染成左上角小白点，
     且图层无法正常缓存导致桌面两段式显示，故改用矢量线性渐变。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF2A2A33"
                android:endColor="#FF101014" />
        </aapt:attr>
    </path>
</vector>
